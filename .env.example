# ---------------------------------------------------------------------------
# Copy this file to ".env.local" (for running on your computer) and fill in
# the values. On Vercel, add the same names under
#   Project -> Settings -> Environment Variables.
#
# These two values are PUBLIC by design (they end up inside the browser
# bundle). Security does NOT depend on hiding them - it depends on the
# database Row Level Security + secure functions shipped in supabase/migrations.
#
# NEVER put the Supabase "service_role" / "secret" key in any VITE_ variable.
# ---------------------------------------------------------------------------

# Supabase Dashboard -> Project Settings -> API (or "Data API") -> Project URL
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase Dashboard -> Project Settings -> API Keys ->
#   "anon public" key (legacy tab) OR the "publishable" key (sb_publishable_...)
VITE_SUPABASE_ANON_KEY=

# Domain used to turn a cashier username into a login email internally.
# Cashier "bazaar1" logs in as "bazaar1@<this domain>". No email is ever sent.
# Keep the default unless Supabase rejects it; then use a domain you own.
VITE_CASHIER_EMAIL_DOMAIN=cashiers.school-pos.app

# ---------------------------------------------------------------------------
# OPTIONAL - only for "npm run test:db" (automated database tests).
# Point it at a DISPOSABLE PostgreSQL server (NOT your Supabase project).
# The test runner creates and drops a database called "pos_test".
# ---------------------------------------------------------------------------
# TEST_DATABASE_URL=postgres://postgres@localhost:5432/postgres
